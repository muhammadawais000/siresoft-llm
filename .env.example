# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Only needed if the frontend is served from a different origin than the
# API (e.g. a separate dev server) -- same-origin Django-template
# deployments (the default here) don't need this set.
CORS_ALLOWED_ORIGINS=

# --- PostgreSQL (with pgvector extension enabled) ---
DATABASE_URL=postgres://siresoft:siresoft@localhost:5432/siresoft_rag

# --- Redis (Celery broker; results are stored in Postgres via django-celery-results) ---
REDIS_URL=redis://localhost:6379/0
# A single ingestion task can legitimately run for minutes on a large PDF;
# these bound how long before a stuck task is killed so it can't wedge the
# queue forever.
CELERY_TASK_SOFT_TIME_LIMIT=900
CELERY_TASK_TIME_LIMIT=1200

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
# Comma-separated list of model tags to offer in the dropdown.
# Only models actually present in `ollama list` are enabled at runtime.
OLLAMA_MODELS=llama3.1:8b,qwen2.5:7b,mistral:7b,gemma2:9b,phi3.5:3.8b
OLLAMA_DEFAULT_MODEL=llama3.1:8b
# How long to wait for Ollama's /api/tags before assuming it's down.
OLLAMA_REQUEST_TIMEOUT=3
# Lower = more literal/deterministic answers. Kept low by default since
# grounded-RAG answers should stick close to the retrieved context.
GENERATION_TEMPERATURE=0.1
# How many prior user+assistant turns feed the history-aware query
# rewriter (runs on every message, so kept small on purpose).
CHAT_HISTORY_TURNS=5

# --- Embeddings ---
# "bge-base" (768-dim, default) or "minilm" (384-dim, low-RAM alternative)
EMBEDDING_PROFILE=bge-base
EMBEDDING_BATCH_SIZE=32

# --- Reranker ---
RERANKER_MODEL=BAAI/bge-reranker-base

# --- Chunking defaults (tokens, via tiktoken as a cross-model proxy) ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Ingestion: OCR fallback for scanned/image PDFs ---
# If PyMuPDF extracts fewer than this many characters per page on average,
# the page is assumed to be an image and re-processed through Tesseract.
OCR_MIN_CHARS_PER_PAGE=20

# --- Retrieval defaults ---
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_POOL=20
# Paired with the default RERANKER_MODEL (bge-reranker-base): its
# calibrated Sigmoid probability sits well under 0.01 for irrelevant
# content and 0.7+ for confident real matches -- confirmed empirically via
# `manage.py prove_retrieval`. Kept conservative (not tuned tight against
# the ~0.99 ceiling) since borderline-but-real matches can score as low as
# ~0.02. Changing RERANKER_MODEL requires recalibrating this too -- e.g.
# bge-reranker-v2-m3 scores on a much smaller scale (irrelevant ~0.00002,
# real matches ~0.0002-0.98), so 0.01 would reject almost everything on it.
RETRIEVAL_SIMILARITY_THRESHOLD=0.01
# Reciprocal Rank Fusion's damping constant (standard value from the
# original RRF paper; rarely needs changing).
RETRIEVAL_RRF_K=60

# --- Upload limits ---
MAX_UPLOAD_SIZE_MB=100
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.txt,.md,.docx
